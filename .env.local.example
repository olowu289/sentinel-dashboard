# Copy to .env.local (gitignored, per-machine) to switch cam1's DETECTION
# source only — video (AI_ENGINE_HOST, WHEP) is untouched, still cable.
#
# Points the detection REST resolve + WS at a local drop-in engine, e.g.
# infra/tools/local_detect.py run with serve_ws:true — see that file's
# module docstring for the wire-compatible detection-engine mode.
#
# Delete this key (or the whole .env.local) to revert cam1's detections to
# the developer's Artemis engine, which is the default when unset.
VITE_AI_DETECTION_BASE_URL=http://127.0.0.1:7789

# Class-agnostic detection-alert banner (AiDetectionBanner) — flashes the
# raw class name(s) from the detection stream ("DRONE", "CAR", whatever the
# model emits), independent of the display-only AI_VIEW_MIN_CONF filter.
# Defaults: enabled, 0.6 confidence. Uncomment to override.
# VITE_AI_ALERT_ENABLED=false
# VITE_AI_ALERT_CONF=0.6
